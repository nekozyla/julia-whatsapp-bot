# Configurações de API de Busca (Google Custom Search)
Search_API_KEY=sua_google_search_api_key
Search_ENGINE_ID=seu_google_search_engine_id

# Integração Telegram (opcional)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token

# Last.fm (usado para comandos de música)
LASTFM_API_KEY=sua_lastfm_api_key

# Outras chaves de serviços de mídia
REMOVE_BG_KEY=sua_chave_remove_bg
IMGFLIP_USERNAME=seu_usuario_imgflip
IMGFLIP_PASSWORD=sua_senha_imgflip

# APIs de Inteligência Artificial (Groq / Gemini / OpenRouter)
GROQ_API_KEY=sua_chave_groq
GEMINI_API_KEY=sua_chave_gemini
OPENROUTER_API_KEY=sua_chave_openrouter
GEMINI_MODELS=gemini-2.5-flash-lite

# Spotify API (usado para letras e informações de músicas)
SPOTIFY_CLIENT_ID=seu_spotify_client_id
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret

# Configurações do Sistema de Aluguel de Grupos (Pix)
RENTAL_PIX_KEY=sua_chave_pix
RENTAL_PIX_RECEIVER_NAME=Nome do Recebedor
RENTAL_PIX_CITY=Cidade do Recebedor
RENTAL_PIX_PRICE_PER_DAY=10
RENTAL_TICKET_EXPIRE_HOURS=24

# Nome e gatilhos de ativação do Bot
BOT_NAME=Julia
BOT_TRIGGER_NAMES=julia

# Integração com Servidor Minecraft (Plugin WhatsAppBridge)
MC_API_SECRET=sua_senha_secreta_do_minecraft_bridge
MC_API_PORT=19134

# Configurações de Super Admins e Sessão do WhatsApp
ADMIN_JIDS=55XXXXXXXXXXX@s.whatsapp.net
AUTH_FILE_PATH=auth_info
SESSIONS_DIR=whatsapp_sessions
